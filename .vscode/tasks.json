{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Engine: Cryoze",
            "type": "shell",
            "command": ".\\compiler\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                // Static Linking (No External .dll Files Required To Run .exe)
                "-g",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                // C++ Files
                "main.cpp",
                "engine/physics/world.cpp",
                "simulations/apple_drop.cpp",

                "-I.", // Include Directory

                "-o",
                "build/engine.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
